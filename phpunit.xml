<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="false"
         failOnWarning="true">

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Requires Elasticsearch running on ELASTICSEARCH_URL (docker compose up -d) -->
        <testsuite name="Functional">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>

    <!--
        elasticsearch-test extension — activates runtime suffixing of FOSElastica indexes.
        All configuration (URL, managed indexes, fixtures) comes from the Symfony bundle
        (tests/Functional/App/config/elasticsearch_test.yaml) and not from these parameters.
    -->
    <extensions>
        <bootstrap class="Podoko\ElasticsearchTest\PHPUnit\ElasticsearchTestExtension"/>
        <!-- Foundry v2.9+ requires its extension to manage the factory lifecycle -->
        <bootstrap class="Zenstruck\Foundry\PHPUnit\FoundryExtension"/>
    </extensions>

    <php>
        <env name="APP_ENV" value="test"/>
        <env name="APP_SECRET" value="test-secret"/>
        <!-- Full URL for the admin client (PodokoElasticsearchTestExtension) -->
        <env name="ELASTICSEARCH_URL" value="http://localhost:9200"/>
        <!-- Separate host/port for FOSElastica (fos_elastica.yaml mini-kernel) -->
        <env name="ELASTICSEARCH_HOST" value="localhost"/>
        <env name="ELASTICSEARCH_PORT" value="9200"/>
        <!-- For ParaTest: each worker receives TEST_TOKEN automatically -->
    </php>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

</phpunit>

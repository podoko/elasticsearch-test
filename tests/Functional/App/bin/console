#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__, 4) . '/vendor/autoload.php';

use Podoko\ElasticsearchTest\Tests\Functional\App\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;

// Charge .env.test depuis la racine du projet si les variables ne sont pas déjà définies.
$envFile = dirname(__DIR__, 4) . '/.env.test';
if (is_file($envFile)) {
    foreach (file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        if (str_starts_with(ltrim($line), '#') || !str_contains($line, '=')) {
            continue;
        }
        [$key, $value] = explode('=', $line, 2);
        $key   = trim($key);
        $value = trim($value);
        if (!isset($_ENV[$key]) && !getenv($key)) {
            $_ENV[$key]    = $value;
            $_SERVER[$key] = $value;
            putenv("$key=$value");
        }
    }
}

// Dérive ELASTICSEARCH_HOST / ELASTICSEARCH_PORT depuis ELASTICSEARCH_URL si absents.
// fos_elastica.yaml a besoin des deux séparément.
$esUrl = getenv('ELASTICSEARCH_URL') ?: 'http://localhost:9200';
$parts = parse_url($esUrl);
foreach ([
    'ELASTICSEARCH_HOST' => $parts['host'] ?? 'localhost',
    'ELASTICSEARCH_PORT' => (string) ($parts['port'] ?? 9200),
    'APP_SECRET'         => 'test-secret',
] as $key => $value) {
    if (!getenv($key)) {
        $_ENV[$key]    = $value;
        $_SERVER[$key] = $value;
        putenv("$key=$value");
    }
}

$_SERVER['APP_ENV']   = 'test';
$_SERVER['APP_DEBUG'] = '1';

$kernel      = new Kernel();
$application = new Application($kernel);
$application->run();
